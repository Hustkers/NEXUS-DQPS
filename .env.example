# ==============================================================================
# NEXUS-DQPS: Autonomous D2C Advertising Decision Engine
# Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SHOPIFY ADMIN API (Inventory, COGS & Realized Sales)
# Portal: https://admin.shopify.com/store/<your-store-name>/settings/apps/development
# Scopes needed: read_products, read_inventory, read_orders, read_locations
# ------------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# ------------------------------------------------------------------------------
# 2. META (FACEBOOK & INSTAGRAM) MARKETING API
# Portal: https://developers.facebook.com/apps & https://business.facebook.com/settings
# Scopes needed: ads_read, ads_management, read_insights
# Note: META_AD_ACCOUNT_ID must include the 'act_' prefix
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_permanent_system_user_access_token
META_AD_ACCOUNT_ID=act_123456789012345

# ------------------------------------------------------------------------------
# 3. GOOGLE ADS API
# Portal: https://console.cloud.google.com & https://ads.google.com (API Center in MCC)
# Note: CUSTOMER_ID is 10 digits without hyphens (e.g., 1234567890)
# ------------------------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=  # Optional: Manager MCC ID if querying client account

# ------------------------------------------------------------------------------
# 4. AMAZON ADS API
# Portal: https://advertising.amazon.com/about-api & https://developer.amazon.com
# ------------------------------------------------------------------------------
AMAZON_ADS_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
AMAZON_ADS_CLIENT_SECRET=your_amazon_client_secret
AMAZON_ADS_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AMAZON_ADS_PROFILE_ID=1234567890123456
AMAZON_ADS_REGION=NA  # NA (North America), EU (Europe), or FE (Far East)

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD VERTEX AI (LLM Reasoning Layer)
# Automatically authenticates via Application Default Credentials (ADC)
# Run: gcloud auth application-default login
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=velvety-carving-494308-c5
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5b. DEEPSEEK API (Automatic Failover when Gemini hits 429 Resource Exhausted)
# ------------------------------------------------------------------------------
DEEPSEEK_API=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Optional third-party API keys (Vertex AI ADC takes precedence)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. ENGINE STORAGE & APPLICATION
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nexus_d2c
MOCK_ADS_API_PORT=8000
